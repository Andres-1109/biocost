# PostgreSQL (Neon) — conexión pooled, usada en runtime por la app
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# PostgreSQL (Neon) — conexión directa (sin pgbouncer), usada solo por Prisma Migrate
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

NODE_ENV=development
PORT=3000

# Secrets de JWT — usa un valor distinto y aleatorio (mínimo 32 caracteres) para cada uno
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_SELECTION_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SELECTION_EXPIRES_IN=5m

# Llave AES-256 para cifrado simétrico de campos reversibles (HU-31), 32 bytes en hex
ENCRYPTION_KEY=

# Resend (HU-04). Si se deja vacío, el link de recuperación se imprime en consola (solo dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL del frontend (CORS + links de emails)
FRONTEND_URL=http://localhost:5173

# Recuperación de contraseña (HU-04)
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

# Rate limiting de login (HU-02)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
